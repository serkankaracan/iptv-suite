<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="IptvSuite.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="IPTV Suite">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{StaticResource ShellWindowBrush}" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Background="{StaticResource ShellNavigationBrush}"
                  Title="IPTV Suite">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView x:Name="AppNavigation" Grid.Row="1"
                        AutomationProperties.AutomationId="AppNavigation"
                        AlwaysShowHeader="False"
                        Background="{StaticResource ShellNavigationBrush}"
                        CompactPaneLength="64"
                        IsBackButtonVisible="Collapsed"
                        IsPaneOpen="True"
                        IsSettingsVisible="False"
                        OpenPaneLength="244"
                        PaneDisplayMode="Auto"
                        SelectionChanged="AppNavigation_SelectionChanged">
            <NavigationView.PaneHeader>
                <StackPanel Margin="4,10,8,16" Orientation="Horizontal" Spacing="12">
                    <Border Width="40" Height="40" Background="{StaticResource ShellAccentMutedBrush}"
                            CornerRadius="12">
                        <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="{StaticResource ShellAccentBrush}"
                                  FontSize="20" Glyph="&#xE768;" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontFamily="Segoe UI Variable Display" FontSize="17"
                                   FontWeight="SemiBold" Text="IPTV Suite" />
                        <TextBlock Foreground="{StaticResource ShellSecondaryTextBrush}"
                                   FontSize="11" Text="AUTHORIZED MEDIA" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="Browse" />
                <NavigationViewItem x:Name="HomeNavigationItem" Content="Home" Tag="Home"
                                    AutomationProperties.AutomationId="AppNavigationHomeItem">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LiveTvNavigationItem" Content="Live TV" Tag="LiveTv"
                                    AutomationProperties.AutomationId="AppNavigationLiveTvItem">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Video" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="MoviesNavigationItem" Content="Movies" Tag="Movies"
                                    AutomationProperties.AutomationId="AppNavigationMoviesItem">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Pictures" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SeriesNavigationItem" Content="Series" Tag="Series"
                                    AutomationProperties.AutomationId="AppNavigationSeriesItem">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItemHeader Content="Planned" />
                <NavigationViewItem Content="Favorites · coming soon" IsEnabled="False"
                                    ToolTipService.ToolTip="Planned feature; no data is collected yet.">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Favorite" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Recent · coming soon" IsEnabled="False"
                                    ToolTipService.ToolTip="Planned feature; viewing history is not stored yet.">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="TV guide · coming soon" IsEnabled="False"
                                    ToolTipService.ToolTip="Planned feature; EPG is not enabled yet.">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Calendar" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Downloads · coming soon" IsEnabled="False"
                                    ToolTipService.ToolTip="Planned feature; downloads are not enabled yet.">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Download" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SourcesNavigationItem" Content="Sources" Tag="Sources"
                                    AutomationProperties.AutomationId="AppNavigationSourcesItem">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Manage" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings · coming soon" IsEnabled="False"
                                    ToolTipService.ToolTip="Planned feature; settings are not available yet.">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Border x:Name="ShellContentFrame" Margin="0,0,12,12"
                    Background="{StaticResource ShellContentBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}" BorderThickness="1"
                    CornerRadius="20">
                <ContentControl x:Name="PageHost" />
            </Border>
        </NavigationView>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IptvSuite.Windows.ContentLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource ShellEyebrowTextStyle}" Text="LIBRARY" />
            <TextBlock x:Name="SectionTitleText" Style="{StaticResource ShellPageTitleStyle}" />
            <TextBlock x:Name="SectionDescriptionText" Style="{StaticResource ShellSecondaryTextStyle}" />
        </StackPanel>

        <Border Grid.Row="1" Padding="18,14"
                Background="{StaticResource ShellCardBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1" CornerRadius="16">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.6*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="LibrarySourceSelector" Header="Playlist source"
                          HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                          AutomationProperties.AutomationId="LibrarySourceSelector"
                          DisplayMemberPath="Name"
                          SelectionChanged="LibrarySourceSelector_SelectionChanged" />
                <ComboBox x:Name="LibraryCategorySelector" Grid.Column="1" Header="Category"
                          HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                          AutomationProperties.AutomationId="LibraryCategorySelector"
                          DisplayMemberPath="Name" IsEnabled="False"
                          SelectionChanged="LibraryCategorySelector_SelectionChanged" />
                <AutoSuggestBox x:Name="LibrarySearchBox" Grid.Column="2" Header="Search"
                                HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                PlaceholderText="Title, season or episode"
                                AutomationProperties.AutomationId="LibrarySearchBox"
                                QuerySubmitted="LibrarySearchBox_QuerySubmitted"
                                TextChanged="LibrarySearchBox_TextChanged" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="LibraryBackButton" Visibility="Collapsed" IsEnabled="False"
                    AutomationProperties.AutomationId="ContentLibraryBackButton"
                    AutomationProperties.Name="Back to the previous content level"
                    Click="LibraryBackButton_Click" Content="Back" />
            <TextBlock x:Name="LibraryContextText" Grid.Column="1" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <ProgressRing x:Name="LibraryProgressRing" Grid.Column="2" Width="20" Height="20"
                          IsActive="False" Visibility="Collapsed"
                          AutomationProperties.Name="Loading content library" />
        </Grid>

        <ListView x:Name="LibraryItems" Grid.Row="3" Background="Transparent" IsItemClickEnabled="True"
                  AutomationProperties.AutomationId="ContentLibraryItems"
                  ItemClick="LibraryItems_ItemClick">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid MaximumRowsOrColumns="5" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Width="216" MinHeight="282" Padding="8" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="218" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource ShellCardBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}" BorderThickness="1"
                                CornerRadius="16">
                            <Grid>
                                <Ellipse Width="116" Height="116" Fill="#1421C7A8" />
                                <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{StaticResource ShellAccentBrush}"
                                          FontSize="42" Glyph="&#xE714;" />
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Foreground="{StaticResource ShellSecondaryTextBrush}"
                                   FontSize="12" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LibraryStatusText"
                       AutomationProperties.AutomationId="ContentLibraryStatusText"
                       AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
            <Button x:Name="LibraryPreviousButton" Grid.Column="1" IsEnabled="False"
                    Click="LibraryPreviousButton_Click" Content="Previous" />
            <Button x:Name="LibraryNextButton" Grid.Column="2" IsEnabled="False"
                    Click="LibraryNextButton_Click" Content="Next" />
        </Grid>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IptvSuite.Windows.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Grid Padding="32" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Home" />
                <TextBlock Text="Choose what you want to watch or manage your authorized sources." TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="LiveTvCard" MinHeight="210" HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="HomeLiveTvCard"
                        AutomationProperties.Name="Open Live TV"
                        Click="LiveTvCard_Click">
                    <Grid Padding="16" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="56" Glyph="&#xE7F4;" />
                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="Live TV" />
                        <TextBlock x:Name="LiveTvCountText" Grid.Row="2" HorizontalAlignment="Center" Text="0 channels" />
                    </Grid>
                </Button>

                <Button x:Name="MoviesCard" Grid.Column="1" MinHeight="210" HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="HomeMoviesCard"
                        AutomationProperties.Name="Open movies"
                        Click="MoviesCard_Click">
                    <Grid Padding="16" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="56" Glyph="&#xE714;" />
                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="Movies" />
                        <TextBlock x:Name="MovieCountText" Grid.Row="2" HorizontalAlignment="Center" Text="0 movies" />
                    </Grid>
                </Button>

                <Button x:Name="SeriesCard" Grid.Column="2" MinHeight="210" HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="HomeSeriesCard"
                        AutomationProperties.Name="Open series"
                        Click="SeriesCard_Click">
                    <Grid Padding="16" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="56" Glyph="&#xE8B2;" />
                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="Series" />
                        <TextBlock x:Name="SeriesCountText" Grid.Row="2" HorizontalAlignment="Center" Text="0 series" />
                    </Grid>
                </Button>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Catalog total" />
                        <TextBlock x:Name="TotalCountText" FontSize="32" Text="0" />
                        <TextBlock Text="Usable items in active snapshots of ready sources." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Button Grid.Column="1" HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="HomeManageSourcesCard"
                        AutomationProperties.Name="Manage playlist sources"
                        Click="SourcesCard_Click">
                    <StackPanel Padding="16" HorizontalAlignment="Center" Spacing="8">
                        <FontIcon FontSize="36" Glyph="&#xE838;" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Manage sources" />
                        <TextBlock Text="Add, rename, refresh, replace or delete an authorized source." TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>

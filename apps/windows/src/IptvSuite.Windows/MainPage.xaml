<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IptvSuite.Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Live TV catalog" />
            <TextBlock x:Name="BuildInfoText" AutomationProperties.AutomationId="BuildInfoText" />
            <TextBlock x:Name="PackageInfoText" AutomationProperties.AutomationId="PackageInfoText" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SourceSelector" TabIndex="0" IsTabStop="True" AutomationProperties.AutomationId="CatalogSourceSelector" AutomationProperties.Name="Playlist source" DisplayMemberPath="Name" SelectionChanged="SourceSelector_SelectionChanged" />
            <ComboBox x:Name="CategorySelector" Grid.Column="1" TabIndex="1" IsTabStop="True" AutomationProperties.AutomationId="CatalogCategorySelector" AutomationProperties.Name="Channel category" DisplayMemberPath="Name" SelectionChanged="CategorySelector_SelectionChanged" />
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="2" TabIndex="2" IsTabStop="True" AutomationProperties.AutomationId="CatalogSearchBox" AutomationProperties.Name="Search channels" PlaceholderText="Search channels" QuerySubmitted="SearchBox_QuerySubmitted" TextChanged="SearchBox_TextChanged" />
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <ListView x:Name="ChannelList" AutomationProperties.AutomationId="CatalogChannelList" AutomationProperties.Name="Channels" ContainerContentChanging="ChannelList_ContainerContentChanging" IsItemClickEnabled="True" ItemClick="ChannelList_ItemClick" ItemsSource="{x:Bind Channels}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate><ItemsStackPanel CacheLength="1" /></ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="44" Padding="8,4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
                                <Grid><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="TV" /><Image Source="{Binding LogoSource}" Stretch="Uniform" /></Grid>
                            </Border>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Number}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="Black" CornerRadius="8">
                    <MediaPlayerElement x:Name="PlaybackSurface" AutomationProperties.AutomationId="PlaybackSurface" AutomationProperties.Name="Live TV playback surface" AreTransportControlsEnabled="False" Stretch="Uniform" />
                </Border>
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayButton" AutomationProperties.AutomationId="PlaybackPlayButton" AutomationProperties.Name="Play channel" Click="PlayButton_Click" Content="Play" IsEnabled="False" />
                    <Button x:Name="PauseButton" Grid.Column="1" AutomationProperties.AutomationId="PlaybackPauseButton" AutomationProperties.Name="Pause channel" Click="PauseButton_Click" Content="Pause" IsEnabled="False" />
                    <Button x:Name="StopButton" Grid.Column="2" AutomationProperties.AutomationId="PlaybackStopButton" AutomationProperties.Name="Stop channel" Click="StopButton_Click" Content="Stop" IsEnabled="False" />
                    <TextBlock x:Name="PlaybackStatusText" Grid.Column="3" AutomationProperties.AutomationId="PlaybackStatusText" AutomationProperties.LiveSetting="Polite" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Playback stopped." />
                </Grid>
            </Grid>
        </Grid>
        <Grid Grid.Row="3">
            <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="CatalogStatusText" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" />
            <ProgressRing x:Name="LoadingIndicator" HorizontalAlignment="Right" AutomationProperties.Name="Loading catalog" IsActive="False" />
        </Grid>
        <StackPanel Grid.Row="4" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button x:Name="PreviousButton" AutomationProperties.AutomationId="CatalogPreviousPage" AutomationProperties.Name="Previous channel page" Click="PreviousButton_Click" Content="Previous" />
            <Button x:Name="NextButton" AutomationProperties.AutomationId="CatalogNextPage" AutomationProperties.Name="Next channel page" Click="NextButton_Click" Content="Next" />
        </StackPanel>
    </Grid>
</Page>

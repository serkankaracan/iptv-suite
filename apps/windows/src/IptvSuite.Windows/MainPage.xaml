<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IptvSuite.Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="48">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="IPTV Suite" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Development bootstrap" />
            <TextBlock
                x:Name="BuildInfoText"
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="BuildInfoText" />
            <TextBlock
                x:Name="PackageInfoText"
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="PackageInfoText" />
        </StackPanel>
    </Grid>
</Page>

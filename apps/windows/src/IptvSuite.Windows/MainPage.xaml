<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IptvSuite.Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Live TV catalog" />
            <TextBlock x:Name="BuildInfoText" AutomationProperties.AutomationId="BuildInfoText" />
            <TextBlock x:Name="PackageInfoText" AutomationProperties.AutomationId="PackageInfoText" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SourceSelector" AutomationProperties.AutomationId="CatalogSourceSelector" AutomationProperties.Name="Playlist source" DisplayMemberPath="Name" SelectionChanged="SourceSelector_SelectionChanged" />
            <ComboBox x:Name="CategorySelector" Grid.Column="1" AutomationProperties.AutomationId="CatalogCategorySelector" AutomationProperties.Name="Channel category" DisplayMemberPath="Name" SelectionChanged="CategorySelector_SelectionChanged" />
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="2" AutomationProperties.AutomationId="CatalogSearchBox" AutomationProperties.Name="Search channels" PlaceholderText="Search channels" QuerySubmitted="SearchBox_QuerySubmitted" TextChanged="SearchBox_TextChanged" />
        </Grid>
        <ListView x:Name="ChannelList" Grid.Row="2" AutomationProperties.AutomationId="CatalogChannelList" AutomationProperties.Name="Channels" ItemsSource="{x:Bind Channels}">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate><ItemsStackPanel CacheLength="1" /></ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="44" Padding="8,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{Binding Number}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="3">
            <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="CatalogStatusText" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" />
            <ProgressRing x:Name="LoadingIndicator" HorizontalAlignment="Right" AutomationProperties.Name="Loading catalog" IsActive="False" />
        </Grid>
        <StackPanel Grid.Row="4" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button x:Name="PreviousButton" AutomationProperties.Name="Previous channel page" Click="PreviousButton_Click" Content="Previous" />
            <Button x:Name="NextButton" AutomationProperties.Name="Next channel page" Click="NextButton_Click" Content="Next" />
        </StackPanel>
    </Grid>
</Page>

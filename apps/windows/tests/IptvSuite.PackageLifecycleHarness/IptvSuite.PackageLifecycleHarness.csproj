<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RootNamespace>IptvSuite.PackageLifecycleHarness</RootNamespace>
    <AssemblyName>IptvSuite.PackageLifecycleHarness</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Prefer32Bit>false</Prefer32Bit>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <AppxBundle>Never</AppxBundle>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <LifecyclePackageFlavor Condition="'$(LifecyclePackageFlavor)' == ''">Baseline</LifecyclePackageFlavor>
    <Version>0.0.1</Version>
    <AssemblyVersion>0.0.1.0</AssemblyVersion>
    <FileVersion>0.0.1.0</FileVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(LifecyclePackageFlavor)' == 'Baseline'">
    <AppxManifest Include="Package.appxmanifest" />
  </ItemGroup>

  <ItemGroup Condition="'$(LifecyclePackageFlavor)' == 'Update'">
    <AppxManifest Include="Package.Update.appxmanifest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\IptvSuite.Windows\Assets\Square150x150Logo.scale-200.png"
             Link="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="..\..\src\IptvSuite.Windows\Assets\Square44x44Logo.scale-200.png"
             Link="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="..\..\src\IptvSuite.Windows\Assets\StoreLogo.png"
             Link="Assets\StoreLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IptvSuite.Application\IptvSuite.Application.csproj" />
    <ProjectReference Include="..\..\src\IptvSuite.Domain\IptvSuite.Domain.csproj" />
    <ProjectReference Include="..\..\src\IptvSuite.Infrastructure\IptvSuite.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="ValidateLifecyclePackageFlavor" BeforeTargets="PrepareForBuild">
    <Error
      Condition="'$(LifecyclePackageFlavor)' != 'Baseline' and '$(LifecyclePackageFlavor)' != 'Update'"
      Text="LifecyclePackageFlavor must be Baseline or Update." />
  </Target>
</Project>
